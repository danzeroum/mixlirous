# Copie para .env e preencha. Nunca commitar o .env real (.gitignore já cobre).

# Credenciais do MinIO/S3 local (config/default.yaml usa storage.type=minio)
REMIX__STORAGE__ACCESS_KEY=minioadmin
REMIX__STORAGE__SECRET_KEY=minioadmin

# Postgres em produção (config/production.yaml lê via ${DATABASE_URL})
DATABASE_URL=postgres://user:password@host:5432/remix_ai?sslmode=require

# Credenciais do docker-compose.yml (modo VPS: postgres + minio em container).
# Os placeholders abaixo são só para dev local — nunca reaproveite `remix`/
# `minioadmin` numa VPS de verdade; o compose recusa subir sem estes três
# definidos (${VAR:?msg}), exatamente como já faz para JWT_SECRET.
POSTGRES_PASSWORD=remix
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Segredo de assinatura do JWT (HS256). Obrigatório fora de CONFIG_ENV=local
# — o binário recusa subir sem ele (ver middleware/auth.rs). Gere um valor
# real, não reaproveite o placeholder abaixo:
#   openssl rand -base64 48
JWT_SECRET=

# Chave do provedor LLM (DeepSeek por padrão — ADR-0009); não necessária no modo Ollama local
REMIX__LLM__API_KEY=

# Ambiente de configuração: local | default | production
CONFIG_ENV=local
